# PollenTokenV2 contract on Base mainnet (revenue claims, balances)
POLLEN_TOKEN_ADDRESS=

# PollenSettlementV2 contract on Base mainnet (x402 payment settlement)
POLLEN_SETTLEMENT_ADDRESS=

# Base RPC endpoint (default: https://mainnet.base.org)
BASE_RPC_URL=https://mainnet.base.org

# Neon Postgres connection string for `pollen sync` / `pollen earnings`
NEON_DATABASE_URL=

# API key for managed-wallet (Para) claims via the Clara proxy
POLLEN_API_KEY=

# Anthropic API key for session subject extraction (`pollen backfill-subjects`)
ANTHROPIC_API_KEY=

# World ID app id used by `pollen verify`
WORLD_ID_APP_ID=

# Pollen API base URL for the x402 demo REPL (default: Clara proxy)
POLLEN_API_URL=
